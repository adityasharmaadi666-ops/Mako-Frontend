# React Router SPA support: send all non-file requests to index.html
RewriteEngine On
RewriteBase /

# Force HTTPS (Hostinger issues free SSL — safe to leave on)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# If the request is not a real file/directory, serve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Long cache for hashed static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg   "access plus 30 days"
  ExpiresByType image/png    "access plus 30 days"
  ExpiresByType image/webp   "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css     "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType font/woff2   "access plus 365 days"
</IfModule>

# Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Never cache config.js so users can edit it live
<Files "config.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, must-revalidate"
  </IfModule>
</Files>
